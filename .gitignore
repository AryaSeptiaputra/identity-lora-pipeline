# Virtual environment
.venv/
.venv-test/

# Data — isinya disediakan Arya, hanya struktur folder yang dijaga lewat .gitkeep
data/raw/*
!data/raw/.gitkeep
data/cropped/*
!data/cropped/.gitkeep
data/face/*
!data/face/.gitkeep
data/upper_body/*
!data/upper_body/.gitkeep
data/lower_body/*
!data/lower_body/.gitkeep

# Bobot model — diunduh otomatis oleh ultralytics saat notebook dijalankan
*.pt

# Notebook checkpoint dan cache Python
.ipynb_checkpoints/
__pycache__/
*.pyc
.pytest_cache/

# Rahasia
.env
